{
  "name": "dsh-clawbot",
  "version": "0.1.4",
  "description": "WeChat ClawBot (Tencent iLink) channel plugin for DeepSeek Harness (DSH): QR login, per-user sessions, model/workspace switching, and an OpenClaw host compatibility layer.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "wechat",
    "weixin",
    "clawbot",
    "ilink",
    "ilink-bot",
    "openclaw",
    "chatbot",
    "ai-agent",
    "cordis",
    "channel",
    "wechat-bot"
  ],
  "author": "yunhai89",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunhai89/dsh-clawbot.git"
  },
  "homepage": "https://github.com/yunhai89/dsh-clawbot#readme",
  "bugs": {
    "url": "https://github.com/yunhai89/dsh-clawbot/issues"
  },
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.9.0"
  },
  "dependencies": {
    "@tencent-weixin/openclaw-weixin": "2.4.10",
    "openclaw": "file:src/compat/openclaw-shim",
    "qrcode": "^1.5.4",
    "silk-wasm": "^3.7.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.4.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.2-rc.1 <0.4.0-0"
    }
  }
}
